<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>

		<OutputType>Exe</OutputType>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<ApplicationId>WallpaperTrade</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

		<TrimMode>full</TrimMode>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(MSBuildProjectDirectory)\keystore\wallpaperTrade.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>wallpapertrade</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>DSCempresa</AndroidSigningStorePass>
		<AndroidSigningKeyPass>DSCempresa</AndroidSigningKeyPass>
		<AndroidUseAapt2>true</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
		<DebugSymbols>false</DebugSymbols>
		<Debugger>Xamarin</Debugger>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">

		<AndroidKeyStore>false</AndroidKeyStore>

		<AndroidUseAapt2>true</AndroidUseAapt2>

		<AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>

		<AndroidPackageFormat>apk</AndroidPackageFormat>

		<Debugger>Xamarin</Debugger>

	</PropertyGroup>

	<ItemGroup>

		<AndroidResource Include="..\..\..\..\Pictures\Saved Pictures\wallpaper1.jpg" Link="Resources\drawable\wallpaper1.jpg" />

		<AndroidResource Include="..\..\..\..\Pictures\Saved Pictures\wallpaper2.jpg" Link="Resources\drawable\wallpaper2.jpg" />

		<AndroidResource Include="..\..\..\..\Pictures\Saved Pictures\wallpaper3.jpg" Link="Resources\drawable\wallpaper3.jpg" />

		<AndroidResource Include="..\..\..\..\Pictures\Saved Pictures\wallpaper4.jpg" Link="Resources\drawable\wallpaper4.jpg" />

	</ItemGroup>

</Project>